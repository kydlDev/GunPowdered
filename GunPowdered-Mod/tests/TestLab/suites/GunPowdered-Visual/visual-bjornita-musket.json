{
  "name": "visual-bjornita-musket",
  "description": "D-098 (the musket action reaches other clients through the player's ZDO) seen from a second client: DrakesTestLab's virtual player Bjornita mirrors Bjorn (peerMirror: pose, gear, mod data on the player), Bjorn holds, fires and reloads the Iron Musket. Pictures from Bjorn's own view of Bjornita holding, firing (front and side) and reloading, plus checks that her rig plays the same actions. A pose that only plays on the shooter's own client would not show on her.",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "arenaReadyClearinventoryGive"
    },
    {
      "do": "hook",
      "name": "GunPowdered.setSkill",
      "args": {
        "name": "Muskets",
        "level": 100
      },
      "contains": "Muskets set to 100",
      "label": "Muskets skill 100: 1.2 s per cartridge (D-157; the reload times below were written for it)"
    },
    {
      "do": "give",
      "prefab": "GP_PaperCartridge",
      "count": 5
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3.5,
      "dz": 4,
      "as": "bjornita"
    },
    {
      "do": "peerMirror",
      "peer": "Bjornita",
      "face": "me",
      "equipment": true
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.musketHeld", "contains": "animation" }, "timeout": 10 },
    { "do": "hook", "name": "GunPowdered.musketZdoSync", "args": { "name": "Bjornita", "on": true }, "contains": "sync on", "label": "DrakesTestLab 0.8.0 peerMirror copies nothing on this game (D-114): the held musket and the shot data go to Bjornita through the test helper" },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "lookAt",
      "target": "bjornita",
      "up": 0.2,
      "left": 3
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketRigOf",
      "args": {
        "name": "Bjornita"
      },
      "contains": "musket model shown True",
      "label": "her character holds the musket Bjorn holds (the rig found the musket model in her hand)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketRigOf",
      "args": {
        "name": "Bjornita"
      },
      "contains": "skipped frames",
      "label": "her rig: how many frames it skipped (logged; D-099 skip guard on a mirrored character)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketRigOf",
      "args": {
        "name": "Bjornita"
      },
      "contains": "action Hold",
      "label": "her arms hold it"
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: bjornita-musket-hold-front"
    },
    {
      "do": "hook",
      "name": "GunPowdered.apiSetLoaded",
      "args": {
        "loaded": 3
      },
      "expect": "set 3, read 3",
      "label": "three cartridges in Bjorn's musket"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketPress",
      "args": {
        "secondary": false
      },
      "contains": "fired",
      "label": "Bjorn fires"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketRigOf",
      "args": {
        "name": "Bjornita"
      },
      "contains": "action Fire",
      "label": "her arms play Bjorn's shot (recoil, 0.35 s: checked before the screenshot)"
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: bjornita-musket-fire-front"
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: bjornita-musket-fire-front-later"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "peerMirror",
      "peer": "Bjornita",
      "face": 90,
      "equipment": true
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: bjornita-musket-hold-side"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketPress",
      "args": {
        "secondary": false
      },
      "contains": "fired",
      "label": "Bjorn fires again"
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: bjornita-musket-fire-side"
    },
    {
      "do": "wait",
      "seconds": 0.15
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: bjornita-musket-fire-side-later"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketPress",
      "args": {
        "secondary": true
      },
      "contains": "reloading",
      "label": "Bjorn starts reloading"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketRigOf",
      "args": {
        "name": "Bjornita"
      },
      "contains": "action Reload",
      "label": "her arms play Bjorn's reload"
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: bjornita-musket-reload-side"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "peerMirror",
      "peer": "Bjornita",
      "on": false
    },
    {
      "do": "peerLeave",
      "name": "*"
    },
    {
      "do": "clearInventory"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
