{
  "name": "visual-harness-fit",
  "description": "T-009i: close-ups of the Asksvin Harness on the saddle (side, 3/4 front, 3/4 rear, from above) to judge whether the straps reach the saddle.",
  "timeout": 120,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    { "do": "clearInventory" },
    { "do": "hook", "name": "GunPowdered.mobileCannonPlace", "args": { "metres": 4 }, "contains": "placed at", "label": "build a Mobile Cannon 4 m in front" },
    { "do": "wait", "seconds": 2 },
    { "do": "hook", "name": "GunPowdered.asksvinSpawn", "contains": "tamed True", "label": "a tame Asksvin" },
    { "do": "wait", "seconds": 1 },
    { "do": "give", "prefab": "GP_AsksvinHarness", "count": 1 },
    { "do": "hook", "name": "GunPowdered.asksvinSaddle", "expect": "saddled True" },
    { "do": "hook", "name": "GunPowdered.asksvinHarnessOn", "expect": "harnessed True, harness items 0", "label": "harness on" },
    { "do": "hook", "name": "GunPowdered.mobileCannonHitch", "expect": "hitch True", "label": "hitched, so the harness model shows" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "hook", "name": "GunPowdered.asksvinSaddleFit", "contains": "bounds centre", "label": "where the saddle really sits (logged)" },
    { "do": "hook", "name": "GunPowdered.freeCamOnAsksvin", "args": { "azimuth": 90, "elevation": 10, "metres": 3 }, "contains": "free camera", "label": "side view" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: harness-side" },
    { "do": "hook", "name": "GunPowdered.freeCamOnAsksvin", "args": { "azimuth": 40, "elevation": 25, "metres": 2.5 }, "contains": "free camera", "label": "3/4 front" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: harness-3q-front" },
    { "do": "hook", "name": "GunPowdered.freeCamOnAsksvin", "args": { "azimuth": 150, "elevation": 25, "metres": 2.5 }, "contains": "free camera", "label": "3/4 rear" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: harness-3q-rear" },
    { "do": "hook", "name": "GunPowdered.freeCamOnAsksvin", "args": { "azimuth": 120, "elevation": 70, "metres": 2.5 }, "contains": "free camera", "label": "from above" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: harness-above" },
    { "do": "hook", "name": "GunPowdered.freeCamOff", "label": "free camera removed" },
    { "do": "hook", "name": "GunPowdered.asksvinRemove", "label": "remove the Asksvin" },
    { "do": "cleanArena" }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" }, { "check": "noErrors", "source": "GunPowdered" } ]
}