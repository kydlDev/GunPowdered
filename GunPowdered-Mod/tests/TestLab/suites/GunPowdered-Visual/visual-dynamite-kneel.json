{
  "name": "visual-dynamite-kneel",
  "description": "D-148 / T-020: setting a Dynamite stick down plays the game's kneel emote. D-158 (user 2026-11-23): the character gets back up by itself after the kneel, and a placed unlit stick shows the dropped-item sparkle in light red (pictured next to a dropped Wood), which goes out once the fuse is lit. User 2026-11-24: every stick is set down the way a player can - 1.2 m in front (walking there first), never farther.",
  "timeout": 70,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "GunPowdered.setSkill",
      "args": {
        "name": "Explosives",
        "level": 50
      },
      "contains": "Explosives set to 50",
      "label": "Explosives skill 50: the 4 s fuse these timings were written for (D-157)"
    },
    {
      "do": "clearInventory"
    },
    {
      "do": "give",
      "prefab": "GP_Dynamite",
      "count": 2,
      "equip": true
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 90,
        "elevation": 8,
        "metres": 3.2
      },
      "contains": "free camera",
      "label": "right side, whole body"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamitePlaceAt",
      "args": {
        "metres": 1.2
      },
      "contains": "placed at",
      "label": "set a stick down 1.2 m in front (kneel)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.playerEmote",
      "expect": "emote kneel",
      "label": "the character kneels"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: dynamite-kneel-side"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.playerEmote",
        "expect": "emote none"
      },
      "timeout": 2
    },
    {
      "do": "hook",
      "name": "GunPowdered.playerEmote",
      "expect": "emote none",
      "label": "D-158: it stood up again by itself"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: dynamite-stood-up-side"
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamiteSparkle",
      "contains": "sparkle shown, playing True",
      "label": "D-158: the placed stick sparkles"
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamiteSparkle",
      "contains": "colour RGBA(1.00, 0.40, 0.40",
      "label": "in light red"
    },
    {
      "do": "spawn",
      "prefab": "Wood",
      "dx": 0.6,
      "dz": 1.4,
      "label": "a dropped Wood beside it, to compare the sparkle"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 0,
        "elevation": 55,
        "metres": 3.0
      },
      "contains": "free camera",
      "label": "close, from the front"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: dynamite-sparkle-close"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 160,
        "elevation": 12,
        "metres": 3.2
      },
      "contains": "free camera",
      "label": "from the front"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamitePlaceAt",
      "args": {
        "metres": 6,
        "stay": true
      },
      "regex": "placed at",
      "label": "the second stick: the player walks 4.8 m on and sets it down 1.2 m in front like any player, kneeling again (stays there for the picture)"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: dynamite-kneel-front"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.playerEmote",
        "expect": "emote none"
      },
      "timeout": 2
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamiteGroundMark",
      "contains": "marked",
      "label": "remember the ground height"
    },
    {
      "do": "give",
      "prefab": "Torch",
      "count": 1,
      "equip": true
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamiteLight",
      "expect": "lit",
      "label": "light the far stick"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamiteSparkle",
      "contains": "sparkle hidden",
      "label": "D-158: the sparkle goes out when the fuse burns"
    },
    {
      "do": "wait",
      "seconds": 5
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamiteTerrainReset",
      "contains": "reset",
      "label": "the hole is undone"
    },
    {
      "do": "hook",
      "name": "GunPowdered.dynamiteGroundBack",
      "expect": "back",
      "label": "the ground is back"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCamOff",
      "label": "free camera removed"
    },
    {
      "do": "clearInventory"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    },
    {
      "check": "logContains",
      "text": "stands up after setting the dynamite down",
      "label": "the stand-up is logged",
      "source": "GunPowdered"
    }
  ]
}
