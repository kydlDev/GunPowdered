{
    "name":  "visual-musket-poses",
    "description":  "D-092: the musket\u0027s own arm poses on the player (hold from 4 sides, reload from 2), GameProbe shots into the session\u0027s _testruns folder.",
    "timeout":  150,
    "steps":  [
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.arena",
                      "contains":  "arena at"
                  },
                  { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
                  {
                      "do":  "give",
                      "prefab":  "GP_Musket",
                      "count":  1,
                      "equip":  true
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.setSkill",
                      "args":  {
                                   "name":  "Muskets",
                                   "level":  100
                               },
                      "contains":  "Muskets set to 100",
                      "label":  "Muskets skill 100: 1.2 s per cartridge (D-157; the reload times below were written for it)"
                  },
                  {
                      "do":  "wait",
                      "seconds":  3
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.musketRig",
                      "contains":  "Hold",
                      "label":  "the rig poses the hold"
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.freeCam",
                      "args":  {
                                   "azimuth":  35,
                                   "elevation":  8,
                                   "metres":  2.6
                               },
                      "contains":  "free camera at"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.5
                  },
                  {
                      "do":  "invoke",
                      "method":  "Kydl.GameProbe.ProbeApi.Screenshot",
                      "label":  "GameProbe shot"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.freeCam",
                      "args":  {
                                   "azimuth":  90,
                                   "elevation":  5,
                                   "metres":  2.6
                               },
                      "contains":  "free camera at"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.5
                  },
                  {
                      "do":  "invoke",
                      "method":  "Kydl.GameProbe.ProbeApi.Screenshot",
                      "label":  "GameProbe shot"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.freeCam",
                      "args":  {
                                   "azimuth":  270,
                                   "elevation":  5,
                                   "metres":  2.6
                               },
                      "contains":  "free camera at"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.5
                  },
                  {
                      "do":  "invoke",
                      "method":  "Kydl.GameProbe.ProbeApi.Screenshot",
                      "label":  "GameProbe shot"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.freeCam",
                      "args":  {
                                   "azimuth":  320,
                                   "elevation":  10,
                                   "metres":  2.6
                               },
                      "contains":  "free camera at"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.5
                  },
                  {
                      "do":  "invoke",
                      "method":  "Kydl.GameProbe.ProbeApi.Screenshot",
                      "label":  "GameProbe shot"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.freeCam",
                      "args":  {
                                   "azimuth":  35,
                                   "elevation":  8,
                                   "metres":  2.6
                               },
                      "contains":  "free camera at"
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.musketAction",
                      "args":  {
                                   "action":  "reload"
                               },
                      "contains":  "playing Reload"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.4
                  },
                  {
                      "do":  "invoke",
                      "method":  "Kydl.GameProbe.ProbeApi.Screenshot",
                      "label":  "GameProbe shot"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.freeCam",
                      "args":  {
                                   "azimuth":  90,
                                   "elevation":  5,
                                   "metres":  2.6
                               },
                      "contains":  "free camera at"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.6
                  },
                  {
                      "do":  "invoke",
                      "method":  "Kydl.GameProbe.ProbeApi.Screenshot",
                      "label":  "GameProbe shot"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.musketRig",
                      "contains":  "Reload",
                      "label":  "the rig is reloading"
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.musketAction",
                      "args":  {
                                   "action":  "fire"
                               },
                      "contains":  "playing Fire"
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.freeCam",
                      "args":  {
                                   "azimuth":  35,
                                   "elevation":  8,
                                   "metres":  2.6
                               },
                      "contains":  "free camera at"
                  },
                  {
                      "do":  "invoke",
                      "method":  "Kydl.GameProbe.ProbeApi.Screenshot",
                      "label":  "GameProbe shot"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "hook",
                      "name":  "GunPowdered.freeCamOff",
                      "contains":  "free camera"
                  },
                  {
                      "do":  "clearInventory"
                  },
                  {
                      "do":  "cleanArena"
                  }
              ],
    "asserts":  [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
                    {
                        "check":  "noErrors",
                        "source":  "GunPowdered"
                    }
                ]
}