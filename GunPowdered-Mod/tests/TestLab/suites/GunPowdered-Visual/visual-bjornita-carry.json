{
  "name": "visual-bjornita-carry",
  "description": "D-155 seen from a second client (user 2026-11-22: 'check it also on Bjornita. Test the aim button press, do real button'; 'do more screenshots at the beginning of the moment when Bjornita gets the musket'): DrakesTestLab's virtual player Bjornita mirrors Bjorn (peerMirror copies his player ZDO). A burst of pictures the moment she gets the musket, with every frame of her rig logged (musketTrace) for the vibration the user saw; then Bjorn runs (the musket goes to his side), holds a shield next to it, and clicks the REAL aim key (pressKey Mouse2): her rig must lower, show the shield in her left hand, and raise with him.",
  "timeout": 120,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "clearInventory" },
    { "do": "give", "prefab": "GP_Musket", "count": 1, "equip": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.musketRaised", "contains": "raised True", "label": "Bjorn's musket is raised before she joins" },
    { "do": "peerJoin", "name": "Bjornita", "dx": 3.5, "dz": 4, "as": "bjornita" },
    { "do": "wait", "seconds": 1 },
    { "do": "lookAt", "target": "bjornita", "up": 0.2, "left": 3 },
    { "do": "hook", "name": "GunPowdered.musketTrace", "args": { "frames": 400 }, "contains": "tracing 400", "label": "log every frame of her rig from now on" },
    { "do": "peerMirror", "peer": "Bjornita", "face": "me", "equipment": true },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-start-00" },
    { "do": "wait", "seconds": 0.1 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-start-01" },
    { "do": "wait", "seconds": 0.1 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-start-02" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-start-03" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-start-04" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-start-05" },
    { "do": "wait", "seconds": 1 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-start-06" },
    { "do": "hook", "name": "GunPowdered.musketRigOf", "args": { "name": "Bjornita" }, "contains": "musket model shown True", "label": "her character holds the musket" },
    { "do": "hook", "name": "GunPowdered.musketRigOf", "args": { "name": "Bjornita" }, "contains": "raised", "label": "raised like Bjorn's" },

    { "do": "hook", "name": "GunPowdered.musketTestSpeed", "args": { "speed": 7 }, "contains": "speed 7", "label": "Bjorn runs: his musket goes to the side" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hook", "name": "GunPowdered.musketTestSpeed", "args": { "speed": 0 }, "contains": "speed 0", "label": "Bjorn stops (the musket stays at the side)" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.musketRigOf", "args": { "name": "Bjornita" }, "contains": "carry 1.00" }, "timeout": 3 },
    { "do": "hook", "name": "GunPowdered.musketRigOf", "args": { "name": "Bjornita" }, "contains": "lowered", "label": "her musket hangs at her side too" },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-side-front" },
    { "do": "peerMirror", "peer": "Bjornita", "face": 90, "equipment": true },
    { "do": "wait", "seconds": 1 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-side-right" },

    { "do": "give", "prefab": "ShieldWood", "count": 1, "equip": true, "label": "Bjorn holds a shield next to the lowered musket" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "hook", "name": "GunPowdered.musketRigOf", "args": { "name": "Bjornita" }, "contains": "lowered", "label": "still lowered on her with the shield" },
    { "do": "peerMirror", "peer": "Bjornita", "face": "me", "equipment": true },
    { "do": "wait", "seconds": 1 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-side-shield-front" },

    { "do": "pressKey", "key": "Mouse2", "frames": 3, "label": "Bjorn clicks the mouse wheel (the real aim key)" },
    { "do": "wait", "seconds": 0.15 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-raising" },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.musketRaised", "contains": "raised True, ready True", "label": "Bjorn's musket is up" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.musketRigOf", "args": { "name": "Bjornita" }, "contains": "carry 0.00" }, "timeout": 3 },
    { "do": "hook", "name": "GunPowdered.musketRigOf", "args": { "name": "Bjornita" }, "contains": "raised", "label": "hers came up too" },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: bjornita-raised" },

    { "do": "hook", "name": "GunPowdered.musketTrace", "args": { "frames": 0 }, "contains": "tracing 0", "label": "frame log off" },
    { "do": "hook", "name": "GunPowdered.musketTestSpeed", "args": { "speed": -1 }, "contains": "speed -1", "label": "the real speed again" },
    { "do": "peerMirror", "peer": "Bjornita", "on": false },
    { "do": "peerLeave", "name": "*" },
    { "do": "clearInventory" },
    { "do": "cleanArena" }
  ],
  "asserts": [
    { "check": "noErrors", "source": "GunPowdered" },
    { "check": "logContains", "text": "MusketInput: aim key Mouse2 down -> raising", "label": "the real key press is logged", "source": "GunPowdered" }
  ]
}
