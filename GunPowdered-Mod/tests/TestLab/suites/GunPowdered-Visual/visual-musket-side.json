{
  "name": "visual-musket-side",
  "description": "D-155: pictures of the Iron Musket at the right side (running), with a torch in the free left hand, during the raise, and raised. Running is the test switch musketTestSpeed (the character stands still, the rig takes 7 m/s).",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "arenaReadyClearinventoryGive"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketTestSpeed",
      "args": {
        "speed": 7
      },
      "contains": "speed 7",
      "label": "running"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketRaised",
      "contains": "raised False",
      "label": "at the side"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 90,
        "elevation": 8,
        "metres": 2.6
      },
      "contains": "free camera",
      "label": "right side"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: musket-side-right"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 35,
        "elevation": 10,
        "metres": 2.6
      },
      "contains": "free camera",
      "label": "front right"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: musket-side-front"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 120,
        "elevation": 25,
        "metres": 1.4
      },
      "contains": "free camera",
      "label": "close on the right hand"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: musket-side-hand"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketTestSpeed",
      "args": {
        "speed": 0
      },
      "contains": "speed 0",
      "label": "stops"
    },
    {
      "do": "give",
      "prefab": "Torch",
      "count": 1,
      "equip": true
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketHands",
      "contains": "other item in the left hand True",
      "label": "torch in the left hand"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 330,
        "elevation": 10,
        "metres": 2.6
      },
      "contains": "free camera",
      "label": "front left"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: musket-side-torch"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 60,
        "elevation": 8,
        "metres": 2.6
      },
      "contains": "free camera",
      "label": "front right"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketAim",
      "expect": "raising",
      "label": "aim"
    },
    {
      "do": "wait",
      "seconds": 0.18
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: musket-raising"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: musket-raised"
    },
    {
      "do": "musketTestEnd",
      "label": "free camera off, the real speed again, empty backpack"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
