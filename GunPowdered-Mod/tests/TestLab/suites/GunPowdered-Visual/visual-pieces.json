{
  "name": "visual-pieces",
  "description": "Leaching Station, Powder Mill and Rain Barrel placed side by side, screenshot of each and of all three",
  "timeout": 90,
  "steps": [
    { "do": "spawn", "prefab": "GP_LeachingVat", "dx": -5, "dz": 6, "as": "vat" },
    { "do": "spawn", "prefab": "GP_PowderMill", "dx": 0, "dz": 6, "as": "mill" },
    { "do": "spawn", "prefab": "GP_RainBarrel", "dx": 5, "dz": 6, "as": "barrel" },
    { "do": "wait", "seconds": 2 },
    { "do": "lookAt", "target": "vat" },
    { "do": "screenshot", "name": "vat" },
    { "do": "lookAt", "target": "mill" },
    { "do": "screenshot", "name": "mill" },
    { "do": "lookAt", "target": "barrel" },
    { "do": "screenshot", "name": "barrel" },
    { "do": "lookAt", "target": "mill", "pitch": -5 },
    { "do": "screenshot", "name": "all-three" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
