{
  "name": "visual-offhand-compare",
  "description": "D-155 (user 2026-11-22: 'equip a club and equip a torch, check position of the torch and of the club'): first the game's own way - Club in the right hand, Torch in the left - then Club and Shield, then the Iron Musket lowered to the side with a Torch and then a Shield next to it (user 2026-11-22: only torches and shields go into the offhand). Pictures from the same views and where each hand model sits, so the torch next to the musket can be compared with the game's left-hand torch. The left hand must never hold the musket while it hangs at the side.",
  "timeout": 90,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "clearInventory" },
    { "do": "give", "prefab": "Club", "count": 1, "equip": true },
    { "do": "give", "prefab": "Torch", "count": 1, "equip": true },
    { "do": "wait", "seconds": 1.5 },
    { "do": "hook", "name": "GunPowdered.handModels", "contains": "right", "label": "the game's own: Club and Torch (logged)" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 330, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "front left" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: club-torch-front-left" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 270, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "left side" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: club-torch-left" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 40, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "front right" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: club-torch-front-right" },

    { "do": "give", "prefab": "ShieldWood", "count": 1, "equip": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.handModels", "contains": "right", "label": "the game's own: Club and Shield (logged)" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 330, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "front left" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: club-shield-front-left" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 270, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "left side" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: club-shield-left" },

    { "do": "clearInventory" },    { "do": "give", "prefab": "GP_Musket", "count": 1, "equip": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.musketTestSpeed", "args": { "speed": 7 }, "contains": "speed 7", "label": "running: the musket goes to the side" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hook", "name": "GunPowdered.musketRaised", "contains": "left arm 0.00", "label": "the left arm is free (the game's animation only)" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 330, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "front left" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: musket-side-no-torch-front-left" },
    { "do": "give", "prefab": "Torch", "count": 1, "equip": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.handModels", "contains": "left hand", "label": "musket and torch (logged)" },
    { "do": "hook", "name": "GunPowdered.musketRaised", "contains": "left arm 0.00", "label": "still free with the torch" },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: musket-torch-front-left" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 270, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "left side" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: musket-torch-left" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 40, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "front right" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: musket-torch-front-right" },
    { "do": "give", "prefab": "ShieldWood", "count": 1, "equip": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.musketHands", "contains": "right ShieldWood, left GP_Musket, musket held True", "label": "the shield replaced the torch next to the lowered musket" },
    { "do": "hook", "name": "GunPowdered.handModels", "contains": "left hand", "label": "musket and shield (logged)" },
    { "do": "hook", "name": "GunPowdered.musketRaised", "contains": "left arm 0.00", "label": "still free with the shield" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 330, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "front left" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: musket-shield-front-left" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 270, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "left side" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: musket-shield-left" },
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 40, "elevation": 10, "metres": 2.4 }, "contains": "free camera", "label": "front right" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: musket-shield-front-right" },    { "do": "hook", "name": "GunPowdered.freeCamOff", "label": "free camera removed" },
    { "do": "hook", "name": "GunPowdered.musketTestSpeed", "args": { "speed": -1 }, "contains": "speed -1", "label": "the real speed again" },
    { "do": "clearInventory" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
