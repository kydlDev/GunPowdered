{
  "name": "visual-cannon",
  "description": "Hand Cannon pictures: the empty stock, the mounted cannon, the cast ball in the hand while loading, the stock turned to a spot off to the side with the aiming line, the fuse sparks at the touch hole, the muzzle blast",
  "timeout": 90,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "spawn", "prefab": "GP_CannonStock", "dx": 1.6, "dz": 2.4, "as": "stock" },
    { "do": "hook", "name": "GunPowdered.cannonAdoptStock", "contains": "adopted", "label": "the hooks use that stock" },
    { "do": "lookAt", "target": "stock", "pitch": -18 },
    { "do": "hook", "name": "GunPowdered.cameraDistance", "args": { "metres": 2.2 }, "label": "camera closer" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "screenshot", "name": "cannon-stock-empty" },
    { "do": "give", "prefab": "GP_Cannon", "count": 1 },
    { "do": "give", "prefab": "GP_Gunpowder", "count": 2 },
    { "do": "give", "prefab": "GP_CannonBall", "count": 1 },
    { "do": "give", "prefab": "Torch", "count": 1, "equip": true },
    { "do": "hook", "name": "GunPowdered.cannonUse", "args": { "alt": false }, "expect": true, "label": "mount" },
    { "do": "wait", "seconds": 1 },
    { "do": "screenshot", "name": "cannon-mounted" },
    { "do": "hook", "name": "GunPowdered.cannonUse", "args": { "alt": false }, "expect": true, "label": "load" },
    { "do": "lookAt", "target": "stock", "pitch": -25, "yawOffset": -40 },
    { "do": "hook", "name": "GunPowdered.cameraDistance", "args": { "metres": 1.4 }, "label": "camera close to the hand" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "screenshot", "name": "cannon-loading-ball-in-hand" },
    { "do": "hook", "name": "GunPowdered.rightHandInfo", "contains": "renderers", "label": "what the right hand shows" },
    { "do": "hook", "name": "GunPowdered.cameraDistance", "args": { "metres": 2.2 }, "label": "camera back" },
    { "do": "wait", "seconds": 3.6 },
    { "do": "lookAt", "target": "stock", "pitch": -10 },
    { "do": "hook", "name": "GunPowdered.cannonAim", "args": { "distance": 20, "side": 35 }, "contains": "aiming True", "label": "aim 20 m, 35 degrees to the side" },
    { "do": "wait", "seconds": 1 },
    { "do": "screenshot", "name": "cannon-aiming-turned" },
    { "do": "hook", "name": "GunPowdered.cannonLight", "expect": "lit", "label": "light the fuse" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "screenshot", "name": "cannon-fuse-sparks" },
    { "do": "wait", "seconds": 0.25 },
    { "do": "screenshot", "name": "cannon-muzzle-blast" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.cannonShotDone", "expect": true }, "timeout": 12 },
    { "do": "hook", "name": "GunPowdered.cameraDistance", "args": { "metres": 4 }, "label": "camera distance back to the default" },
    { "do": "hook", "name": "GunPowdered.cannonCleanup", "contains": "cleaned", "label": "stock removed" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}