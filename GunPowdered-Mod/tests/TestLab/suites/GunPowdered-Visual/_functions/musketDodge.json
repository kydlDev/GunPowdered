{
  "params": [ "shot", "after" ],
  "actions": [
    { "do": "hook", "name": "GunPowdered.freeCam", "args": { "azimuth": 90, "elevation": 10, "metres": 4.5 }, "contains": "free camera", "label": "{{shot}}: from the right side" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: {{shot}}-before" },
    { "do": "hook", "name": "GunPowdered.musketGrip", "contains": "musket under RightHand_Attach", "label": "{{shot}}: before the dodge the musket is in the right hand" },
    { "do": "hook", "name": "GunPowdered.playerDodge", "contains": "dodge queued", "label": "{{shot}}: dodge" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.musketGrip", "contains": "dodging True" }, "timeout": 1.5 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: {{shot}}-roll-1" },
    { "do": "hook", "name": "GunPowdered.musketGrip", "contains": "musket under RightHand_Attach", "label": "{{shot}}: in the roll the musket stays in the right hand" },
    { "do": "hook", "name": "GunPowdered.musketRaised", "contains": "game pose (dodge)", "label": "{{shot}}: the game's own roll plays" },
    { "do": "wait", "seconds": 0.15 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: {{shot}}-roll-2" },
    { "do": "wait", "seconds": 0.15 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: {{shot}}-roll-3" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.musketGrip", "contains": "dodging False" }, "timeout": 2 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "invoke", "method": "Kydl.GameProbe.ProbeApi.Screenshot", "label": "GameProbe shot: {{shot}}-after" },
    { "do": "hook", "name": "GunPowdered.musketGrip", "contains": "musket under RightHand_Attach", "label": "{{shot}}: after the roll it is still in the right hand" },
    { "do": "hook", "name": "GunPowdered.musketRaised", "contains": "{{after}}", "label": "{{shot}}: after the roll the musket is {{after}} again" }
  ],
  "asserts": []
}