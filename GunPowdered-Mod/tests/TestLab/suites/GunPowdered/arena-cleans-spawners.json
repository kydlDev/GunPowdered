{
    "name": "arena-cleans-spawners",
    "description": "User 2026-11-23 ('test cleanup does also removes any spawners created by the previous tests'): the first-step hook GunPowdered.arena destroys spawners (CreatureSpawner, SpawnArea such as a bone pile) and creatures left by an earlier test. Two spawners and a Greydwarf are placed, the arena step must report and remove them, and a second arena step finds nothing left.",
    "timeout": 60,
    "steps": [
        {
            "do": "hook",
            "name": "GunPowdered.arena",
            "contains": "arena at",
            "label": "start on the arena spot"
        },
        { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
        {
            "do": "spawn",
            "prefab": "BonePileSpawner",
            "dz": 20,
            "as": "pile"
        },
        {
            "do": "spawn",
            "prefab": "Spawner_Draugr",
            "dx": 5,
            "dz": 25,
            "as": "draugrSpawner"
        },
        {
            "do": "spawn",
            "prefab": "Greydwarf",
            "dz": 30,
            "as": "leftover"
        },
        {
            "do": "wait",
            "seconds": 1
        },
        {
            "do": "hook",
            "name": "GunPowdered.arena",
            "regex": ".*creatures [1-9][0-9]*,.*, 2 spawner\\(s\\),.*",
            "label": "the arena step removes both spawners (GunPowdered cleanup) and the creature(s) (KydlCore cleanup: creatures N) a test left behind"
        },
        { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
        {
            "do": "wait",
            "seconds": 1
        },
        {
            "do": "hook",
            "name": "GunPowdered.arena",
            "regex": ".*creatures 0,.*, 0 spawner\\(s\\),.*",
            "label": "nothing is left for the next test"
        },
        { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
        {
            "do": "console",
            "command": "killall"
        }
    ],
    "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
        {
            "check": "noErrors",
            "source": "GunPowdered"
        }
    ]
}
