{
  "name": "grenade-aim-block-only",
  "description": "Spiked Grenade aiming (D-050): the right button while just holding the grenade (left button not down) is not aiming - the buttons go through as usual, nothing is thrown",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "holdGrenadeFacing" },
    { "do": "hook", "name": "GunPowdered.aimInput", "args": { "value": "block" }, "label": "right button only" },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.aimState", "contains": "Idle", "label": "no aiming from the right button alone" },
    { "do": "hook", "name": "GunPowdered.grenadesLeft", "expect": 5, "label": "nothing thrown" },
    { "do": "hook", "name": "GunPowdered.aimInput", "args": { "value": "off" }, "label": "real input again" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
