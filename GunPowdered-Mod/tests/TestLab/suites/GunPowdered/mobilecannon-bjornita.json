{
  "name": "mobilecannon-bjornita",
  "description": "T-009 two clients: Bjornita (a second client) takes over the tamed, harnessed Asksvin that tows the Mobile Cannon; the hitch stays in the ZDO while she owns it, and the host's joint is rebuilt when the animal comes back to the host. Logs the clevis gap and the cannon's state on both sides.",
  "timeout": 180,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "peerJoin" },
    { "do": "spawn", "prefab": "GP_MobileCannon", "dz": 4, "owner": "me", "as": "cannon" },
    { "do": "spawn", "prefab": "Asksvin", "dz": 9, "as": "asksvin" },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.mobileCannonFind", "regex": "found at \\d+ m", "label": "the cannon is there" },
    { "do": "hook", "name": "GunPowdered.asksvinFind", "regex": "found at \\d+ m", "label": "the Asksvin is there" },
    { "do": "hook", "name": "GunPowdered.asksvinTame", "expect": "tamed True" },
    { "do": "hook", "name": "GunPowdered.asksvinSaddle", "expect": "saddled True" },
    { "do": "give", "prefab": "GP_AsksvinHarness", "count": 1 },
    { "do": "hook", "name": "GunPowdered.asksvinHarnessOn", "expect": "harnessed True, harness items 0" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "hook", "name": "GunPowdered.mobileCannonHitch", "expect": "hitch True" },
    { "do": "wait", "seconds": 2 },
    { "do": "hook", "name": "GunPowdered.mobileCannonTowState", "contains": "towed True, joint True", "label": "hitched, the host owns the animal (clevis logged)" },
    { "do": "peerOwn", "target": "asksvin" },
    { "do": "wait", "seconds": 3 },
    { "do": "check", "check": "zdoOwner", "target": "asksvin", "expect": "Bjornita", "label": "Bjornita's client owns the Asksvin" },
    { "do": "hook", "name": "GunPowdered.mobileCannonTowState", "contains": "towed True", "label": "still hitched in the ZDO while she owns the animal (joint state logged)" },
    { "do": "hook", "name": "GunPowdered.mobileCannonGunState", "contains": "loaded", "label": "cannon state with the animal on her client (logged)" },
    { "do": "peerOwn", "peer": "me", "target": "asksvin" },
    { "do": "wait", "seconds": 3 },
    { "do": "check", "check": "zdoOwner", "target": "asksvin", "expect": "me", "label": "the animal is back with the host" },
    { "do": "hook", "name": "GunPowdered.mobileCannonTowState", "contains": "towed True, joint True", "label": "the host's joint is rebuilt" },
    { "do": "hook", "name": "GunPowdered.mobileCannonHitch", "expect": "hitch True", "label": "unhitch" },
    { "do": "mobileCannonAsksvinCleanup" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
