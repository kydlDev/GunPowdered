{
  "name": "mobilecannon-bjornita",
  "description": "T-009 two clients: Bjornita (a second client) takes over the tamed, harnessed Asksvin that tows the Mobile Cannon: the host hands her the cannon too (push); when the animal comes back to the host, the host takes the cannon back itself (pull) and rebuilds the joint. Every owner change, the peers' reference positions and the clevis are logged.",
  "timeout": 180,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    {
      "do": "peerJoin"
    },
    {
      "do": "spawn",
      "prefab": "GP_MobileCannon",
      "dz": 4,
      "owner": "me",
      "as": "cannon"
    },
    {
      "do": "spawn",
      "prefab": "Asksvin",
      "dz": 9,
      "as": "asksvin"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonFind",
      "regex": "found at \\d+ m",
      "label": "the cannon is there"
    },
    {
      "do": "hook",
      "name": "GunPowdered.asksvinFind",
      "regex": "found at \\d+ m",
      "label": "the Asksvin is there"
    },
    {
      "do": "hook",
      "name": "GunPowdered.asksvinTame",
      "expect": "tamed True"
    },
    {
      "do": "asksvinHitched"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTowState",
      "contains": "towed True, joint True",
      "label": "hitched, the host owns the animal (clevis logged)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonOwners",
      "contains": "cannon is mine, animal is mine",
      "label": "both on the host before the hand-over"
    },
    {
      "do": "peerOwn",
      "peer": "Bjornita",
      "target": "asksvin"
    },
    {
      "do": "check",
      "check": "zdoOwner",
      "target": "asksvin",
      "expect": "Bjornita",
      "label": "Bjornita's client owns the Asksvin"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonOwners",
      "contains": "cannon is Bjornita's",
      "label": "the host handed her the cannon too (push)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTowState",
      "contains": "towed True, joint False",
      "label": "still hitched in the ZDO, no joint on the host while she simulates it"
    },
    {
      "do": "peerOwn",
      "peer": "me",
      "target": "asksvin"
    },
    {
      "do": "check",
      "check": "zdoOwner",
      "target": "asksvin",
      "expect": "me",
      "label": "the animal is back with the host"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonOwners",
      "contains": "cannon is mine, animal is mine",
      "label": "the host took the cannon back itself (pull)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTowState",
      "contains": "towed True, joint True",
      "label": "the host's joint is rebuilt"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonHitch",
      "expect": "hitch True",
      "label": "unhitch"
    },
    {
      "do": "mobileCannonAsksvinCleanup"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
