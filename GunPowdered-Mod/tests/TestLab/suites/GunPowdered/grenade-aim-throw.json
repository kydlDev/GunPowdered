{
  "name": "grenade-aim-throw",
  "description": "Spiked Grenade aiming (D-050): the left button held = aiming (camera stays), mouse up/down moves the landing spot farther/nearer, left/right swings it, letting go throws onto the chosen spot",
  "timeout": 90,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "holdGrenadeFacing" },
    { "do": "hook", "name": "GunPowdered.lookYaw", "expect": 0, "label": "facing straight ahead" },
    { "do": "hook", "name": "GunPowdered.aimInput", "args": { "value": "hold" }, "label": "left button down" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "hook", "name": "GunPowdered.aimState", "contains": "Aiming", "label": "holding = aiming, nothing thrown yet" },
    { "do": "hook", "name": "GunPowdered.grenadesLeft", "expect": 5, "label": "no grenade thrown while the button is held" },
    { "do": "hook", "name": "GunPowdered.aimMouse", "args": { "value": "0,-100" }, "label": "mouse far down" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "hook", "name": "GunPowdered.aimState", "contains": "spot 2.0 m", "label": "down = nearer, stops at the minimum" },
    { "do": "hook", "name": "GunPowdered.aimMouse", "args": { "value": "0,100" }, "label": "mouse far up" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "hook", "name": "GunPowdered.aimState", "contains": "spot 15.0 m", "label": "up = farther, stops at the maximum" },
    { "do": "hook", "name": "GunPowdered.aimMouse", "args": { "value": "0,-5" }, "label": "mouse a little down" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "hook", "name": "GunPowdered.aimState", "contains": "spot 12.5 m", "label": "5 units down = 2.5 m nearer" },
    { "do": "hook", "name": "GunPowdered.aimMouse", "args": { "value": "100,0" }, "label": "mouse far right" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "hook", "name": "GunPowdered.aimState", "contains": "60.0 deg", "label": "right = swings right, stops at the limit" },
    { "do": "hook", "name": "GunPowdered.aimMouse", "args": { "value": "-200,0" }, "label": "mouse far left" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "hook", "name": "GunPowdered.aimState", "contains": "-60.0 deg", "label": "left = swings left, stops at the limit" },
    { "do": "hook", "name": "GunPowdered.aimMouse", "args": { "value": "60,0" }, "label": "mouse back to the middle" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "hook", "name": "GunPowdered.aimState", "contains": "0.0 deg", "label": "back on the centre line" },
    { "do": "hook", "name": "GunPowdered.lookYaw", "expect": 0, "label": "the camera did not turn while aiming" },
    { "do": "hook", "name": "GunPowdered.aimInput", "args": { "value": "release" }, "label": "left button let go" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.grenadeBlastSeen", "expect": true }, "timeout": 12 },
    { "do": "hook", "name": "GunPowdered.grenadeFollowedArc", "expect": "ok", "label": "the blast is on the chosen spot" },
    { "do": "hook", "name": "GunPowdered.grenadesLeft", "expect": 4, "label": "one grenade was thrown" },
    { "do": "hook", "name": "GunPowdered.aimInput", "args": { "value": "off" }, "label": "real input again" },
    { "do": "cleanArena" }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" }, { "check": "noErrors", "source": "GunPowdered" } ]
}
