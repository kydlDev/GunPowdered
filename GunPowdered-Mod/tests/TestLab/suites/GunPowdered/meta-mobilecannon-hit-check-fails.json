{
  "name": "meta-mobilecannon-hit-check-fails",
  "description": "D-179 negative test: the health check must fail when the hit DOES damage (blunt 500), so mobilecannon-fire-proof cannot pass with a check that never fails.",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    {
      "do": "mobileCannonPlaced"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonHit",
      "args": {
        "kind": "blunt",
        "damage": 500
      },
      "contains": "hit blunt 500",
      "label": "a 500 blunt hit"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonHealthSame",
      "contains": "same health",
      "label": "the hit did no damage"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonRemove",
      "label": "cannon removed"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ],
  "expectFailure": "the hit did no damage"
}
