{
  "name": "vat-step1",
  "description": "Leaching Station step 1 (D-129, D-132): Second Leaching Barrel within 5 m: holds at most 20 Bat Guano + 20 Water + 8 Wood, one use puts in half (10 Bat Guano); from one base batch it starts by itself and a run takes the whole base batches inside (up to 2) for 5 Saltpeter each 5, in 25 min; filling goes on during the run up to the full batch; the finished Saltpeter piles up, the next run starts at once while a base batch is inside, and E takes the whole pile",
  "timeout": 150,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    {
      "do": "vatExtensions",
      "barrel": true
    },
    {
      "do": "give",
      "prefab": "GP_BatGuano",
      "count": 60
    },
    {
      "do": "give",
      "prefab": "GP_Water",
      "count": 60
    },
    {
      "do": "give",
      "prefab": "Wood",
      "count": 24
    },
    {
      "do": "spawn",
      "prefab": "GP_LeachingVat",
      "dz": 4,
      "owner": "me",
      "as": "vat"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "check",
      "check": "hoverText",
      "target": "vat",
      "contains": "Upgrades 1/5: up to 20 Bat Guano + 20 Water + 8 Wood -> 10 Saltpeter, 25 min",
      "label": "step 1: the hover names the step's full batch and run time"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "0",
      "label": "use 1: 0 Bat Guano waiting inside (half a batch per use, at most 20), a run of 1 base batch(es) started by itself"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 1: state 1"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_units",
      "value": "1",
      "label": "the run takes 1 base batch(es) (up to 2 at step 1)"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "10",
      "label": "use 2: 10 Bat Guano waiting inside (half a batch per use, at most 20)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 2: state 1"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "20",
      "label": "use 3: 20 Bat Guano waiting inside (half a batch per use, at most 20)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 3: state 1"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "20",
      "label": "use 4: 20 Bat Guano waiting inside (half a batch per use, at most 20)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 4: state 1"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_minutes",
      "value": "25",
      "label": "the run takes 25 minutes at step 1"
    },
    {
      "do": "vatRunEnds",
      "early": 1380,
      "pile": "5",
      "pileCount": 5,
      "state": "1",
      "units": "2"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
