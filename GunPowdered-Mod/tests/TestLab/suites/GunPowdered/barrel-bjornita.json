{
  "name": "barrel-bjornita",
  "description": "Rain Barrel in multiplayer: Bjornita (a second client) asks the owner for water; the owner hands out what she asked, and never more than the barrel holds even when she asks for 5000",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    { "do": "peerJoin" },
    { "do": "spawn", "prefab": "GP_RainBarrel", "dz": 4, "owner": "me", "as": "barrel" },
    { "do": "setZdo", "target": "barrel", "key": "gp_water", "type": "float", "value": 25 },
    { "do": "peerRpc", "target": "barrel", "method": "GP_RainTake", "args": [ 20 ], "types": [ "int" ] },
    { "do": "check", "check": "peerReceived", "method": "GP_RainTaken", "types": [ "int" ], "args": [ 20 ], "label": "Bjornita got the 20 Water she asked for" },
    { "do": "peerClear" },
    { "do": "peerRpc", "target": "barrel", "method": "GP_RainTake", "args": [ 5000 ], "types": [ "int" ] },
    { "do": "check", "check": "peerReceived", "method": "GP_RainTaken", "types": [ "int" ], "args": [ 5 ], "label": "asking for 5000 gives only the 5 left in the barrel" },
    { "do": "check", "check": "noItem", "prefab": "GP_Water", "label": "the host got none of her water" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}