{
  "name": "barrel-rain",
  "description": "Rain Barrel (D-010): under open sky in rain (devcommand env Rain) the barrel fills by itself (5 Water per minute -> at least 2 after 40 s); weather reset afterwards",
  "timeout": 90,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "console", "command": "env Rain" },
    { "do": "spawn", "prefab": "GP_RainBarrel", "dz": 4, "owner": "me", "as": "barrel" },
    { "do": "wait", "seconds": 40 },
    { "do": "check", "check": "hook", "name": "GunPowdered.zdoNumber", "args": { "target": "barrel", "key": "gp_water" }, "min": 2, "max": 5, "label": "the barrel filled with rain water (2-5 after 40 s)" },
    { "do": "console", "command": "resetenv" },
    { "do": "cleanArena" }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" }, { "check": "noErrors", "source": "GunPowdered" } ]
}