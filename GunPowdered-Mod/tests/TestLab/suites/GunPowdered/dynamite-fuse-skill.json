{
  "name": "dynamite-fuse-skill",
  "description": "D-157 (user 2026-11-23: dynamite fuse one second longer than now at Explosives level 0, one second shorter at level 100): at level 0 a lit stick still stands after 4.5 s and blows by 5.6 s; at level 100 it blows by 3.4 s. Lighting trains the skill.",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "clearInventory" },
    { "do": "hook", "name": "GunPowdered.setSkill", "args": { "name": "Explosives", "level": 0 }, "contains": "Explosives set to 0", "label": "Explosives skill 0" },
    { "do": "hook", "name": "GunPowdered.skillOf", "args": { "name": "Explosives" }, "contains": "fuse 5.00 s", "label": "level 0 gives a 5 s fuse" },
    { "do": "give", "prefab": "GP_Dynamite", "count": 2, "equip": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.dynamitePlaceAt", "args": { "metres": 8 }, "contains": "placed at", "label": "a stick 8 m away" },
    { "do": "hook", "name": "GunPowdered.dynamiteGroundMark", "contains": "marked", "label": "remember the ground height" },
    { "do": "give", "prefab": "Torch", "count": 1, "equip": true },
    { "do": "wait", "seconds": 0.5 },
    { "do": "hook", "name": "GunPowdered.dynamiteLight", "expect": "lit", "label": "light it (level 0)" },
    { "do": "hook", "name": "GunPowdered.skillOf", "args": { "name": "Explosives" }, "notContains": "Explosives 0.0:", "label": "lighting trained the skill" },
    { "do": "wait", "seconds": 4.5 },
    { "do": "hook", "name": "GunPowdered.dynamiteBlastsSinceLight", "expect": 0, "label": "after 4.5 s it still burns (5 s fuse)" },
    { "do": "wait", "seconds": 1.1 },
    { "do": "hook", "name": "GunPowdered.dynamiteBlastsSinceLight", "expect": 1, "label": "by 5.6 s it blew" },
    { "do": "hook", "name": "GunPowdered.dynamiteTerrainReset", "contains": "reset", "label": "the hole is undone" },
    { "do": "hook", "name": "GunPowdered.dynamiteGroundBack", "expect": "back", "label": "the ground is back" },

    { "do": "hook", "name": "GunPowdered.setSkill", "args": { "name": "Explosives", "level": 100 }, "contains": "Explosives set to 100", "label": "Explosives skill 100" },
    { "do": "clearInventory" },
    { "do": "give", "prefab": "GP_Dynamite", "count": 1, "equip": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.dynamitePlaceAt", "args": { "metres": 8 }, "contains": "placed at", "label": "another stick 8 m away" },
    { "do": "hook", "name": "GunPowdered.dynamiteGroundMark", "contains": "marked", "label": "remember the ground height" },
    { "do": "give", "prefab": "Torch", "count": 1, "equip": true },
    { "do": "wait", "seconds": 0.5 },
    { "do": "hook", "name": "GunPowdered.dynamiteLight", "expect": "lit", "label": "light it (level 100)" },
    { "do": "wait", "seconds": 2.5 },
    { "do": "hook", "name": "GunPowdered.dynamiteBlastsSinceLight", "expect": 0, "label": "after 2.5 s it still burns (3 s fuse)" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "hook", "name": "GunPowdered.dynamiteBlastsSinceLight", "expect": 1, "label": "by 3.4 s it blew" },
    { "do": "hook", "name": "GunPowdered.dynamiteTerrainReset", "contains": "reset", "label": "the hole is undone" },
    { "do": "hook", "name": "GunPowdered.dynamiteGroundBack", "expect": "back", "label": "the ground is back" },
    { "do": "clearInventory" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
