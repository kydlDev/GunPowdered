{
  "name": "grenade-arc",
  "description": "Spiked Grenade (D-047): while a grenade is in hand the arc and landing ring are drawn; looking steeply down puts the thrower inside the blast (red ring); no grenade in hand, no arc",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "grenadeArena" },
    { "do": "hook", "name": "GunPowdered.arcShown", "expect": "hidden", "label": "no arc without a grenade" },
    { "do": "give", "prefab": "GP_SpikedGrenade", "count": 5, "equip": true },
    { "do": "face", "dz": 10, "pitch": 30 },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.arcShown", "contains": "red=False", "label": "the arc lands well away (normal ring)" },
    { "do": "hook", "name": "GunPowdered.arcShown", "contains": "landing at", "label": "a landing ring is drawn" },
    { "do": "face", "dz": 10, "pitch": -75 },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.arcShown", "contains": "red=True", "label": "looking down at the feet: red ring" },
    { "do": "clearInventory" },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.arcShown", "expect": "hidden", "label": "grenade gone: arc hidden" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
