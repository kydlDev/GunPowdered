{
  "name": "bonepiles-wet-get-mud",
  "description": "D-015 on the real world (user 2026-11-23): the 8 swamp graves (Grave1) by water get Sulfurous Mud next to their bone pile, all of it in the water.",
  "timeout": 360,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    {
      "do": "hook",
      "name": "GunPowdered.visitSpots",
      "args": {
        "kind": "pileWet",
        "count": 8
      },
      "contains": "started",
      "label": "visit 8 real pileWet spot(s)",
      "stop": true
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.visitLeft",
        "expect": 0
      },
      "timeout": 300
    },
    {
      "do": "hook",
      "name": "GunPowdered.visitVerdict",
      "args": {
        "rule": "mudEachWet"
      },
      "expect": "ok",
      "label": "every bone pile by water has mud, all of it under water"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}