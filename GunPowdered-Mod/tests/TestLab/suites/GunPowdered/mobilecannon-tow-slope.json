{
  "name": "mobilecannon-tow-slope",
  "description": "T-009: on the KydlFlat template mountain cliff (20 m rise over a 25 m run, about 39 degrees; the template own slope, nothing built) the Asksvin tows the Mobile Cannon down the face, turns round below and tows it back up onto the top: the cannon never flips (the upright keeper logs every hold) and stays hitched. The Asksvin runs straight down and up the face (asksvinDriveTo): the pathfinder found no way down in 2 of 3 runs.",
  "timeout": 150,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "GunPowdered.goToMountainCliffTop",
      "label": "on the cliff top, 15 m from the edge",
      "args": {
        "metres": 15
      },
      "contains": "on the mountain cliff top"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.groundUnderPlayer",
        "expect": true
      },
      "timeout": 30
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "mobileCannonPlaced"
    },
    {
      "do": "hook",
      "name": "GunPowdered.asksvinSpawn",
      "label": "a tame Asksvin north of the cannon, facing the edge",
      "contains": "tamed True"
    },
    {
      "do": "asksvinHitched"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTowState",
      "label": "hitched on the top, upright",
      "regex": "towed True, joint True, .*upright True"
    },
    {
      "do": "hook",
      "name": "GunPowdered.asksvinDriveTo",
      "label": "down the cliff face",
      "args": {
        "x": 200,
        "z": -112
      },
      "contains": "driving to"
    },
    {
      "do": "wait",
      "seconds": 4
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCamOnAsksvin",
      "label": "camera beside",
      "args": {
        "azimuth": 90,
        "elevation": 15,
        "metres": 12
      },
      "contains": "free camera"
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: towing down the cliff"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.cannonHeightBetween",
        "args": {
          "min": 50,
          "max": 56
        },
        "expect": true
      },
      "timeout": 30
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTowState",
      "label": "came down the 20 m cliff with the cannon, never flipped",
      "regex": "towed True, joint True, .*upright True.*flips 0"
    },
    {
      "do": "hook",
      "name": "GunPowdered.asksvinDriveTo",
      "label": "turn round below and back up onto the top",
      "args": {
        "x": 200,
        "z": -160
      },
      "contains": "driving to"
    },
    {
      "do": "wait",
      "seconds": 5
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: towing up the cliff"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.cannonHeightBetween",
        "args": {
          "min": 70,
          "max": 76
        },
        "expect": true
      },
      "timeout": 30
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTowState",
      "label": "towed back up onto the top (cannon above 70 m), never flipped",
      "regex": "towed True, joint True, .*upright True.*flips 0"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCamOff",
      "label": "camera back",
      "contains": "free camera"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonHitch",
      "label": "unhitch",
      "expect": "hitch True"
    },
    {
      "do": "mobileCannonAsksvinCleanup"
    },
    {
      "do": "hook",
      "name": "GunPowdered.asksvinDriveStop",
      "expect": "drive stopped"
    },
    {
      "do": "hook",
      "name": "GunPowdered.backFromCliff",
      "contains": "back to the arena spot",
      "label": "back to the arena with the game teleport (the next test must not land on unloaded ground)"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.groundUnderPlayer",
        "expect": true
      },
      "timeout": 30
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
