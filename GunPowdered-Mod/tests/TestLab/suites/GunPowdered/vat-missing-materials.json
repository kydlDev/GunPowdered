{
  "name": "vat-missing-materials",
  "description": "Leaching Station start rule (D-132): it never starts below one base batch - with 10 Bat Guano + 7 Water + 4 Wood inside it waits; using it with nothing to add says exactly what is missing ('Needs 3 more Water'), on screen and in the hover; 3 more Water make the base batch and it starts by itself",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    {
      "do": "give",
      "prefab": "GP_BatGuano",
      "count": 10
    },
    {
      "do": "give",
      "prefab": "GP_Water",
      "count": 7
    },
    {
      "do": "give",
      "prefab": "Wood",
      "count": 4
    },
    {
      "do": "spawn",
      "prefab": "GP_LeachingVat",
      "dz": 4,
      "owner": "me",
      "as": "vat"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "check",
      "check": "message",
      "contains": "Added 5 Bat Guano, 5 Water and 2 Wood",
      "label": "the first use says what went in"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_water",
      "value": "7",
      "label": "all 7 Water are in"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "10",
      "label": "and 10 Bat Guano"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "none",
      "label": "10 + 7 + 4 is less than a base batch: no start"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "check",
      "check": "message",
      "kind": "Center",
      "contains": "Needs 3 more Water",
      "label": "nothing to add: it names the missing Water"
    },
    {
      "do": "check",
      "check": "hoverText",
      "target": "vat",
      "contains": "Cannot start yet: Needs 3 more Water",
      "label": "the hover names the missing Water too"
    },
    {
      "do": "give",
      "prefab": "GP_Water",
      "count": 3
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "with the 3 Water it starts by itself"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
