{
  "name": "vat-missing-materials",
  "description": "Leaching Station (D-035): with only 5 of the 10 Bat Guano, using the station puts in the 5 Bat Guano and the 10 Water but the barrel is not ready until the rest comes",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "give", "prefab": "GP_BatGuano", "count": 5 },
    { "do": "give", "prefab": "GP_Water", "count": 10 },
    { "do": "spawn", "prefab": "GP_LeachingVat", "dz": 4, "owner": "me", "as": "vat" },
    { "do": "interact", "target": "vat" },
    { "do": "wait", "seconds": 1 },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_guano", "value": "5", "label": "5 Bat Guano in the barrel" },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_water", "value": "10", "label": "10 Water in the barrel" },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_loaded", "value": "none", "label": "barrel NOT ready (5 Bat Guano missing)" },
    { "do": "check", "check": "noItem", "prefab": "GP_BatGuano", "label": "the Bat Guano left the inventory" },
    { "do": "give", "prefab": "GP_BatGuano", "count": 5 },
    { "do": "interact", "target": "vat" },
    { "do": "wait", "seconds": 1 },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_loaded", "value": "1", "label": "with the other 5 Bat Guano the barrel is ready" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}