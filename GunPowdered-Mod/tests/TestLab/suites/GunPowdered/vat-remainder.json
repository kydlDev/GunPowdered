{
  "name": "vat-remainder",
  "description": "Leaching Station whole base batches only (D-129, D-132): at step 1 (one extension) with 15 Bat Guano + 15 Water + 6 Wood, the first use (10 + 10 + 4) starts one base batch by itself (5 Saltpeter, 25 min), the second use puts the other 5 + 5 + 2 in during the run; when the run ends its 5 Saltpeter pile up and the station STOPS (5 + 5 + 2 is less than a base batch); E takes the 5 Saltpeter and the 5 + 5 + 2 stay in",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "vatExtensions",
      "barrel": true
    },
    {
      "do": "give",
      "prefab": "GP_BatGuano",
      "count": 15
    },
    {
      "do": "give",
      "prefab": "GP_Water",
      "count": 15
    },
    {
      "do": "give",
      "prefab": "Wood",
      "count": 6
    },
    {
      "do": "spawn",
      "prefab": "GP_LeachingVat",
      "dz": 4,
      "owner": "me",
      "as": "vat"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "10 + 10 + 4 inside: it starts by itself"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_units",
      "value": "1",
      "label": "one base batch"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_out",
      "value": "5",
      "label": "for 5 Saltpeter"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_minutes",
      "value": "25",
      "label": "in 25 minutes (step 1)"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "5",
      "label": "the second use puts 5 Bat Guano in during the run"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_water",
      "value": "5",
      "label": "and 5 Water"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_fuel",
      "value": "2",
      "label": "and 2 Wood"
    },
    {
      "do": "console",
      "command": "skiptime 1600"
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_ready",
      "value": "5",
      "label": "the run's 5 Saltpeter piled up"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "0",
      "label": "5 + 5 + 2 is less than a base batch: the station stopped"
    },
    {
      "do": "check",
      "check": "hoverText",
      "target": "vat",
      "contains": "Cannot start yet: Needs 5 more Bat Guano, 5 more Water and 2 more Wood",
      "label": "the hover names what a base batch still needs"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "check",
      "check": "hasItem",
      "prefab": "GP_Saltpeter",
      "count": 5,
      "label": "5 Saltpeter collected"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_ready",
      "value": "0",
      "label": "the pile is empty"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "5",
      "label": "the 5 Bat Guano are still in for the next run"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
