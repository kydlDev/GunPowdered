{
  "name": "grenade-damages-buildings",
  "description": "Spiked Grenade (D-047, changed by D-100: only the dynamite is special): a wood wall standing on the landing point loses health from the blast like from any other damage",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "grenadeArena" },
    { "do": "give", "prefab": "GP_SpikedGrenade", "count": 5, "equip": true },
    { "do": "face", "dz": 10, "pitch": 30 },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.spawnAtLanding", "args": { "prefab": "woodwall" }, "expect": "placed woodwall", "label": "a wood wall stands on the landing point" },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.throwGrenade", "expect": true, "label": "the grenade is thrown" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.grenadeBlastSeen", "expect": true }, "timeout": 12 },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.blastProbe", "args": { "radius": 4 }, "contains": "chars", "label": "diagnosis: what the blast collects" },
    { "do": "hook", "name": "GunPowdered.pieceDamaged", "args": { "prefab": "woodwall" }, "expect": true, "label": "the wall is damaged by the blast" },
    { "do": "hook", "name": "GunPowdered.removeLandingPieces", "expect": "removed 1", "label": "the wall is taken away again" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
