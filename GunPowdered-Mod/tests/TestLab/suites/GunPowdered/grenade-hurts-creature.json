{
  "name": "grenade-hurts-creature",
  "description": "Spiked Grenade (D-047): a Boar standing on the drawn landing point is killed by the blast (60 blunt + 30 pierce + 10 fire, 4 m radius)",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "grenadeArena" },
    { "do": "give", "prefab": "GP_SpikedGrenade", "count": 5, "equip": true },
    { "do": "face", "dz": 10, "pitch": 30 },
    { "do": "spawn", "prefab": "Boar", "dz": 20 },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.creatureToLanding", "args": { "prefab": "Boar" }, "expect": true, "label": "the Boar stands on the landing point" },
    { "do": "hook", "name": "GunPowdered.throwGrenade", "expect": true, "label": "the grenade is thrown" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.grenadeBlastSeen", "expect": true }, "timeout": 12 },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.countCreatures", "args": { "prefab": "Boar" }, "expect": 0, "label": "the Boar is dead" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
