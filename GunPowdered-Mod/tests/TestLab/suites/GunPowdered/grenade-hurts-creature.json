{
  "name": "grenade-hurts-creature",
  "description": "Spiked Grenade (D-047): a Boar standing on the drawn landing point is killed by the blast (60 blunt + 30 pierce + 10 fire, 4 m radius) A second grenade at a Troll (backstab used up) sets it burning (D-123) and does not kill it.",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    {
      "do": "grenadeArena"
    },
    {
      "do": "give",
      "prefab": "GP_SpikedGrenade",
      "count": 5,
      "equip": true
    },
    {
      "do": "face",
      "dz": 10,
      "pitch": 30
    },
    {
      "do": "spawn",
      "prefab": "Boar",
      "dz": 20
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.creatureToLanding",
      "args": {
        "prefab": "Boar"
      },
      "expect": true,
      "label": "the Boar stands on the landing point"
    },
    {
      "do": "hook",
      "name": "GunPowdered.throwGrenade",
      "expect": true,
      "label": "the grenade is thrown"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.grenadeBlastSeen",
        "expect": true
      },
      "timeout": 12
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.countCreatures",
      "args": {
        "prefab": "Boar"
      },
      "expect": 0,
      "label": "the Boar is dead"
    },
    {
      "do": "spawn",
      "prefab": "Troll",
      "dz": 20
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.creatureToLanding",
      "args": {
        "prefab": "Troll"
      },
      "expect": true,
      "label": "a Troll stands on the landing point"
    },
    {
      "do": "hook",
      "name": "GunPowdered.creatureBackstabUsed",
      "args": {
        "prefab": "Troll"
      },
      "expect": "backstab used on Troll",
      "label": "its backstab used up (D-125), so the grenade's own hit is measured"
    },
    {
      "do": "hook",
      "name": "GunPowdered.throwGrenade",
      "expect": true,
      "label": "the second grenade is thrown"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.grenadeBlastSeen",
        "expect": true
      },
      "timeout": 12
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.burningOn",
      "args": {
        "prefab": "Troll"
      },
      "regex": "burning True, per tick [0-9].*",
      "label": "the Troll burns (D-123: grenade fire 5/s for 5 s)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.countCreatures",
      "args": {
        "prefab": "Troll"
      },
      "expect": 1,
      "label": "the Troll survives the grenade"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}