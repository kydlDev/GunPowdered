{
  "params": [
    "early",
    "pile",
    "pileCount",
    "state",
    "units"
  ],
  "actions": [
    {
      "do": "console",
      "command": "skiptime {{early}}"
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "do": "zdoIs",
      "target": "mill",
      "key": "gp_mill_ready",
      "value": "none",
      "label": "2 minutes before the end of the grinding nothing is piled up yet"
    },
    {
      "do": "console",
      "command": "skiptime 240"
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "do": "zdoIs",
      "target": "mill",
      "key": "gp_mill_ready",
      "value": "{{pile}}",
      "label": "the grinding's {{pile}} Gunpowder piled up"
    },
    {
      "do": "zdoIs",
      "target": "mill",
      "key": "gp_mill_state",
      "value": "{{state}}",
      "label": "after the grinding: state {{state}} (1 = the next grinding started at once, 0 = less than a base batch left)"
    },
    {
      "do": "zdoIs",
      "target": "mill",
      "key": "gp_mill_units",
      "value": "{{units}}",
      "label": "the next grinding takes {{units}} base batch(es)"
    },
    {
      "do": "check",
      "check": "hoverText",
      "target": "mill",
      "contains": "Collect {{pile}} Gunpowder",
      "label": "the hover offers the pile"
    },
    {
      "do": "millUse"
    },
    {
      "do": "check",
      "check": "hasItem",
      "prefab": "GP_Gunpowder",
      "count": "{{pileCount}}",
      "label": "E took all {{pile}} Gunpowder"
    },
    {
      "do": "zdoIs",
      "target": "mill",
      "key": "gp_mill_ready",
      "value": "0",
      "label": "the pile is empty"
    }
  ],
  "asserts": []
}
