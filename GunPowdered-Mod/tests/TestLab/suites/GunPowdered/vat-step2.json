{
  "name": "vat-step2",
  "description": "Leaching Station step 2 (D-129, D-132): Second Leaching Barrel, Settling Tank within 5 m: holds at most 30 Bat Guano + 30 Water + 12 Wood, one use puts in half (15 Bat Guano); from one base batch it starts by itself and a run takes the whole base batches inside (up to 3) for 5 Saltpeter each 5, in 20 min; filling goes on during the run up to the full batch; the finished Saltpeter piles up, the next run starts at once while a base batch is inside, and E takes the whole pile",
  "timeout": 150,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    {
      "do": "vatExtensions",
      "barrel": true,
      "tank": true
    },
    {
      "do": "give",
      "prefab": "GP_BatGuano",
      "count": 90
    },
    {
      "do": "give",
      "prefab": "GP_Water",
      "count": 90
    },
    {
      "do": "give",
      "prefab": "Wood",
      "count": 36
    },
    {
      "do": "spawn",
      "prefab": "GP_LeachingVat",
      "dz": 4,
      "owner": "me",
      "as": "vat"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "check",
      "check": "hoverText",
      "target": "vat",
      "contains": "Upgrades 2/5: up to 30 Bat Guano + 30 Water + 12 Wood -> 15 Saltpeter, 20 min",
      "label": "step 2: the hover names the step's full batch and run time"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "5",
      "label": "use 1: 5 Bat Guano waiting inside (half a batch per use, at most 30), a run of 1 base batch(es) started by itself"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 1: state 1"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_units",
      "value": "1",
      "label": "the run takes 1 base batch(es) (up to 3 at step 2)"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "20",
      "label": "use 2: 20 Bat Guano waiting inside (half a batch per use, at most 30)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 2: state 1"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "30",
      "label": "use 3: 30 Bat Guano waiting inside (half a batch per use, at most 30)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 3: state 1"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "30",
      "label": "use 4: 30 Bat Guano waiting inside (half a batch per use, at most 30)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 4: state 1"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_minutes",
      "value": "20",
      "label": "the run takes 20 minutes at step 2"
    },
    {
      "do": "vatRunEnds",
      "early": 1080,
      "pile": "5",
      "pileCount": 5,
      "state": "1",
      "units": "3"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
