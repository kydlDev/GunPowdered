{
  "name": "mill-craft",
  "description": "Powder Mill (D-007, D-014): 3 Saltpeter + 1 Coal + 1 SulfurStone crafted at a placed Powder Mill give 5 Gunpowder",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "spawn", "prefab": "GP_PowderMill", "dz": 4, "owner": "me", "as": "mill" },
    { "do": "give", "materialsFor": "GP_Gunpowder" },
    { "do": "craft", "prefab": "GP_Gunpowder", "free": false, "station": "mill" },
    { "do": "check", "check": "hasItem", "prefab": "GP_Gunpowder", "count": 5, "label": "5 Gunpowder crafted" },
    { "do": "check", "check": "noItem", "prefab": "GP_Saltpeter", "label": "the Saltpeter was used up" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}