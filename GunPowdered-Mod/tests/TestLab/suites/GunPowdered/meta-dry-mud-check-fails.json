{
  "name": "meta-dry-mud-check-fails",
  "description": "Negative test for bonepiles-dry-no-mud: judged with the dry rule, a bone pile by water (it has mud) must FAIL, so the 'no mud' check can catch mud.",
  "timeout": 150,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    {
      "do": "hook",
      "name": "GunPowdered.visitSpots",
      "args": {
        "kind": "pileWet",
        "count": 1
      },
      "contains": "started",
      "label": "visit 1 real pileWet spot(s)",
      "stop": true
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.visitLeft",
        "expect": 0
      },
      "timeout": 90
    },
    {
      "do": "hook",
      "name": "GunPowdered.visitVerdict",
      "args": {
        "rule": "noMud"
      },
      "expect": "ok",
      "label": "no mud at the bone pile by water (must fail)"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ],
  "expectFailure": "no mud at the bone pile by water"
}