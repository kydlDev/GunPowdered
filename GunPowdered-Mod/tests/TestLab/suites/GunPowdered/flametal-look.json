{
  "name": "flametal-look",
  "description": "D-192 (user 2026-11-24 18:27, replaces D-182's runtime swap): every flametal part uses GunPowdered's own Flametal-like materials from the bundle - the Flametal Cannon Ball (item and flight), the Mobile Cannon (barrel, blue glowing bands, shiny wheel metal on both tyres), the Flametal Heater and the drying oven; nothing uses the game's ingot material any more, and the Iron Cannon Ball has no flametal part.",
  "timeout": 40,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "GunPowdered.arenaGround",
        "contains": "ground flat"
      },
      "timeout": 45
    },
    {
      "do": "hook",
      "name": "GunPowdered.flametalLook",
      "args": {
        "prefab": "GP_FlametalCannonBall"
      },
      "regex": "flametal slots [1-9][0-9]* of [0-9]+: .*model=ext_flametal_mat;.*",
      "label": "Flametal Cannon Ball"
    },
    {
      "do": "hook",
      "name": "GunPowdered.flametalLook",
      "args": {
        "prefab": "GP_FlametalCannonBall_projectile"
      },
      "regex": "flametal slots [1-9][0-9]* of [0-9]+: .*ext_flametal_mat;.*",
      "label": "its flight"
    },
    {
      "do": "hook",
      "name": "GunPowdered.flametalLook",
      "args": {
        "prefab": "GP_MobileCannon"
      },
      "regex": "flametal slots [1-9][0-9]* of [0-9]+: .*cannon_bands=flametal_glow_mat;.*cannon_barrel=flametal_mat;.*",
      "label": "Mobile Cannon barrel and glowing bands"
    },
    {
      "do": "hook",
      "name": "GunPowdered.flametalLook",
      "args": {
        "prefab": "GP_MobileCannon"
      },
      "regex": ".*wheel_left_tyre=flametal_wheel_mat;.*wheel_right_tyre=flametal_wheel_mat;.*",
      "label": "both tyres use the shiny wheel metal"
    },
    {
      "do": "hook",
      "name": "GunPowdered.flametalLook",
      "args": {
        "prefab": "GP_FlametalHeater"
      },
      "regex": "flametal slots [1-9][0-9]* of [0-9]+: .*ext_heater_box=ext_flametal_mat;.*",
      "label": "Flametal Heater"
    },
    {
      "do": "hook",
      "name": "GunPowdered.flametalLook",
      "args": {
        "prefab": "GP_MillOven"
      },
      "regex": "flametal slots [1-9][0-9]* of [0-9]+: .*mill_ov_box=ext_flametal_mat;.*",
      "label": "Flametal Drying Oven"
    },
    {
      "do": "hook",
      "name": "GunPowdered.flametalLook",
      "args": {
        "prefab": "GP_MobileCannon"
      },
      "notContains": "Flametalore_Mat",
      "label": "no part uses the game's ingot material any more"
    },
    {
      "do": "hook",
      "name": "GunPowdered.flametalLook",
      "args": {
        "prefab": "GP_CannonBall"
      },
      "contains": "flametal slots 0 of",
      "label": "the Iron Cannon Ball has no flametal part (the check tells them apart)"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
