{
  "name": "bucket-no-water",
  "description": "Bucket: using the empty bucket on dry ground does not fill it and gives no water",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "give", "prefab": "GP_Bucket", "count": 1, "equip": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.bucketUse", "expect": "handled GP_Bucket", "label": "the empty bucket is used" },
    { "do": "wait", "seconds": 3 },
    { "do": "check", "check": "noItem", "prefab": "GP_Water", "label": "no water on dry ground" },
    { "do": "hook", "name": "GunPowdered.heldPrefab", "expect": "GP_Bucket", "label": "the bucket stays empty" },
    { "do": "cleanArena" }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" }, { "check": "noErrors", "source": "GunPowdered" } ]
}