{
  "name": "barrel-owned-by-bjornita",
  "description": "Rain Barrel owned by another client: the host's request goes to Bjornita's client, which runs the mod and answers; the host gets the 15 Water",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "peerJoin" },
    { "do": "spawn", "prefab": "GP_RainBarrel", "dz": 4, "owner": "me", "as": "barrel" },
    { "do": "setZdo", "target": "barrel", "key": "gp_water", "type": "float", "value": 15 },
    { "do": "peerOwn", "peer": "Bjornita", "target": "barrel" },
    { "do": "check", "check": "zdoOwner", "target": "barrel", "expect": "Bjornita", "label": "Bjornita's client owns the barrel" },
    { "do": "interact", "target": "barrel" },
    { "do": "wait", "seconds": 2 },
    { "do": "check", "check": "hasItem", "prefab": "GP_Water", "count": 15, "label": "the host got the 15 Water through Bjornita's client" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}