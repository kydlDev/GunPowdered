{
  "name": "mobilecannon-fortress",
  "description": "D-107: the Mobile Cannon ball chips away at an Ashlands fortress gate (tool tier 5 piece, 6000 health): a level shot from 9 m lowers its health.",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "mobileCannonPlaced"
    },
    {
      "do": "give",
      "prefab": "GP_Gunpowder",
      "count": 3
    },
    {
      "do": "give",
      "prefab": "GP_CannonBall",
      "count": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonCrank",
      "args": {
        "notches": 4
      },
      "contains": "turned 4",
      "label": "barrel 4 degrees up (level it would hit the ground at the muzzle)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonLoad",
      "label": "load at the muzzle (barrel level)",
      "expect": "loading"
    },
    {
      "do": "wait",
      "seconds": 5
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonGunState",
      "label": "loaded",
      "contains": "loaded True"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTargetAhead",
      "label": "an Ashlands fortress gate door 9 m in front of the muzzle (solid; tool tier 5, 6000 health; the gate frame let the ball through its opening, a9dmg2)",
      "args": {
        "prefab": "Ashlands_Fortress_Gate_Door",
        "metres": 9
      },
      "contains": "target Ashlands_Fortress_Gate_Door at 9 m, health 6000"
    },
    {
      "do": "give",
      "prefab": "Torch",
      "count": 1,
      "equip": true
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonLight",
      "label": "light the fuse",
      "expect": "lit"
    },
    {
      "do": "wait",
      "seconds": 4
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonLastShot",
      "label": "the shot (logged)",
      "contains": "flew"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTargetHealth",
      "label": "the ball chipped the fortress gate (D-107: blunt/pickaxe 120 + pierce 50, tool tier 5)",
      "regex": "^([0-9]{1,3}|[0-5][0-9]{3}) of 6000"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonTargetRemove",
      "label": "gate removed",
      "contains": "removed"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonRemove",
      "label": "cannon removed",
      "contains": "removed"
    },
    {
      "do": "clearInventory"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
