{
  "name": "musket-reload-skill",
  "description": "D-157 (user 2026-11-23: 'increase current load duration from 1.2s per cartridge to 1.8s, and have the 1.8s load time be at skill lvl 0, and at lvl 100 have the 1.2s duration'): with the Muskets skill at 0 one cartridge takes 1.8 s (none in after 1.5 s, one after 2.0 s); at 100 it takes 1.2 s (one in after 1.3 s). (Each cartridge adds 0.2 to the skill's progress - too little to show as a level here, checked in the log: GunSkills.Raise.)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "arenaReadyClearinventoryGive"
    },
    {
      "do": "give",
      "prefab": "GP_PaperCartridge",
      "count": 5
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.setSkill",
      "args": {
        "name": "Muskets",
        "level": 0
      },
      "contains": "Muskets set to 0",
      "label": "Muskets skill 0"
    },
    {
      "do": "hook",
      "name": "GunPowdered.skillOf",
      "args": {
        "name": "Muskets"
      },
      "contains": "reload 1.80 s",
      "label": "level 0 gives 1.8 s per cartridge"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketPress",
      "args": {
        "secondary": true
      },
      "contains": "reloading",
      "label": "start a reload"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketLoaded",
      "expect": 0,
      "label": "after 1.5 s nothing is in yet"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketLoaded",
      "expect": 1,
      "label": "after 2.0 s the first cartridge is in"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketPress",
      "args": {
        "secondary": false
      },
      "contains": "fired",
      "label": "a shot stops the reload"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.setSkill",
      "args": {
        "name": "Muskets",
        "level": 100
      },
      "contains": "Muskets set to 100",
      "label": "Muskets skill 100"
    },
    {
      "do": "hook",
      "name": "GunPowdered.skillOf",
      "args": {
        "name": "Muskets"
      },
      "contains": "reload 1.20 s",
      "label": "level 100 gives 1.2 s per cartridge"
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketPress",
      "args": {
        "secondary": true
      },
      "contains": "reloading",
      "label": "start a reload"
    },
    {
      "do": "wait",
      "seconds": 1.3
    },
    {
      "do": "hook",
      "name": "GunPowdered.musketLoaded",
      "expect": 1,
      "label": "after 1.3 s one cartridge is in"
    },
    {
      "do": "clearInventory"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
