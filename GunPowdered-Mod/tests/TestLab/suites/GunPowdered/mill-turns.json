{
  "name": "mill-turns",
  "description": "Powder Mill (D-026, D-137): the sweep arm stands still while the mill is idle, turns by itself on every client while it grinds, and stops when the grinding ends with nothing left to grind",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    {
      "do": "give",
      "prefab": "GP_Saltpeter",
      "count": 3
    },
    {
      "do": "give",
      "prefab": "Coal",
      "count": 1
    },
    {
      "do": "give",
      "prefab": "SulfurStone",
      "count": 1
    },
    {
      "do": "spawn",
      "prefab": "GP_PowderMill",
      "dz": 4,
      "owner": "me",
      "as": "mill"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.millArm",
      "args": {
        "target": "mill"
      },
      "contains": "",
      "label": "arm position noted"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "GunPowdered.millArm",
      "args": {
        "target": "mill"
      },
      "expect": "still",
      "label": "idle: the arm stands still"
    },
    {
      "do": "millUse"
    },
    {
      "do": "millUse"
    },
    {
      "do": "zdoIs",
      "target": "mill",
      "key": "gp_mill_state",
      "value": "1",
      "label": "a base batch is in: it grinds"
    },
    {
      "do": "hook",
      "name": "GunPowdered.millArm",
      "args": {
        "target": "mill"
      },
      "contains": "",
      "label": "arm position noted while grinding"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "GunPowdered.millArm",
      "args": {
        "target": "mill"
      },
      "expect": "turning",
      "label": "grinding: the arm turns"
    },
    {
      "do": "console",
      "command": "skiptime 720"
    },
    {
      "do": "wait",
      "seconds": 4
    },
    {
      "do": "zdoIs",
      "target": "mill",
      "key": "gp_mill_state",
      "value": "0",
      "label": "the grinding ended, nothing left: idle"
    },
    {
      "do": "hook",
      "name": "GunPowdered.millArm",
      "args": {
        "target": "mill"
      },
      "contains": "",
      "label": "arm position noted after the grinding"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "GunPowdered.millArm",
      "args": {
        "target": "mill"
      },
      "expect": "still",
      "label": "the arm has stopped"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
