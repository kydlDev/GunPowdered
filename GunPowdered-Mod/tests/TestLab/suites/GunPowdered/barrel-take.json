{
  "name": "barrel-take",
  "description": "Rain Barrel (D-023): using a barrel that holds 30 Water puts all 30 into the inventory",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "spawn", "prefab": "GP_RainBarrel", "dz": 4, "owner": "me", "as": "barrel" },
    { "do": "setZdo", "target": "barrel", "key": "gp_water", "type": "float", "value": 30 },
    { "do": "interact", "target": "barrel" },
    { "do": "wait", "seconds": 1 },
    { "do": "check", "check": "hasItem", "prefab": "GP_Water", "count": 30, "label": "all 30 Water taken into the inventory" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}