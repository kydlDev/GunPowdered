{
  "name": "vat-batch",
  "description": "Leaching Station step 0 (D-129, D-132) without extensions: holds at most 10 Bat Guano + 10 Water + 4 Wood, one use puts in half (5 Bat Guano); from one base batch it starts by itself and a run takes the whole base batches inside (up to 1) for 5 Saltpeter each 5, in 30 min; filling goes on during the run up to the full batch; the finished Saltpeter piles up, the next run starts at once while a base batch is inside, and E takes the whole pile",
  "timeout": 150,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    {
      "do": "give",
      "prefab": "GP_BatGuano",
      "count": 30
    },
    {
      "do": "give",
      "prefab": "GP_Water",
      "count": 30
    },
    {
      "do": "give",
      "prefab": "Wood",
      "count": 12
    },
    {
      "do": "spawn",
      "prefab": "GP_LeachingVat",
      "dz": 4,
      "owner": "me",
      "as": "vat"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "check",
      "check": "hoverText",
      "target": "vat",
      "contains": "Upgrades 0/5: up to 10 Bat Guano + 10 Water + 4 Wood -> 5 Saltpeter, 30 min",
      "label": "step 0: the hover names the step's full batch and run time"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "5",
      "label": "use 1: 5 Bat Guano waiting inside (half a batch per use, at most 10)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "none",
      "label": "use 1: state none"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "0",
      "label": "use 2: 0 Bat Guano waiting inside (half a batch per use, at most 10), a run of 1 base batch(es) started by itself"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 2: state 1"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_units",
      "value": "1",
      "label": "the run takes 1 base batch(es) (up to 1 at step 0)"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "5",
      "label": "use 3: 5 Bat Guano waiting inside (half a batch per use, at most 10)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 3: state 1"
    },
    {
      "do": "vatUse"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "10",
      "label": "use 4: 10 Bat Guano waiting inside (half a batch per use, at most 10)"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "use 4: state 1"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_minutes",
      "value": "30",
      "label": "the run takes 30 minutes at step 0"
    },
    {
      "do": "vatRunEnds",
      "early": 1680,
      "pile": "5",
      "pileCount": 5,
      "state": "1",
      "units": "1"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
