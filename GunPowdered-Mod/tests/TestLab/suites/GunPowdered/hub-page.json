{
  "name": "hub-page",
  "description": "KydlCore acceptance (spec 4): the mod is in the F6 hub with its tabs, the page renders through the shared UI, the hub opens and closes cleanly",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    {
      "do": "hook",
      "name": "kc.hubOpen",
      "args": {
        "mod": "com.kydldev.GunPowdered"
      },
      "expect": true
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "kc.hubIsOpen",
        "expect": true
      },
      "timeout": 5
    },
    {
      "do": "hook",
      "name": "kc.hubMods",
      "contains": "com.kydldev.GunPowdered"
    },
    {
      "do": "hook",
      "name": "kc.hubTabs",
      "args": {
        "mod": "com.kydldev.GunPowdered"
      },
      "contains": "example",
      "label": "example tab"
    },
    {
      "do": "hook",
      "name": "kc.hubTabs",
      "args": {
        "mod": "com.kydldev.GunPowdered"
      },
      "contains": "settings",
      "label": "settings tab"
    },
    {
      "do": "check",
      "check": "uiVisible",
      "text": "Example",
      "label": "the example page is drawn"
    },
    {
      "do": "hook",
      "name": "kc.hubClose"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "kc.hubIsOpen",
        "expect": false
      },
      "timeout": 5
    },
    { "do": "cleanArena" }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
