{
  "name": "deposit-pick-guano",
  "description": "Bat Guano deposit (D-022): mined with a pickaxe in hand it gives the amount stored in the deposit (2)",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "hook", "name": "GunPowdered.clearLoose", "args": { "prefab": "GP_BatGuano" }, "label": "no loose GP_BatGuano left from an earlier test" },
    { "do": "give", "prefab": "PickaxeAntler", "count": 1, "equip": true },
    { "do": "spawnAndPick", "prefab": "GP_GuanoDeposit" },
    { "do": "hook", "name": "GunPowdered.countWithInventory", "args": { "prefab": "GP_BatGuano" }, "expect": 2, "label": "2 Bat Guano from the deposit" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}