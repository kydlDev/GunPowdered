{
  "name": "vat-bjornita",
  "description": "Leaching Station in multiplayer (D-035, D-132): Bjornita's client feeds one item per request like the game's Smelter - a Stone and an 11th Bat Guano are refused; the base batch starts by itself on the host's station; she can fill during the run; her collect request gives HER the whole pile",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 15 },
    {
      "do": "peerJoin"
    },
    {
      "do": "spawn",
      "prefab": "GP_LeachingVat",
      "dz": 4,
      "owner": "me",
      "as": "vat"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "Stone"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "none",
      "label": "a Stone is refused"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "10",
      "label": "10 Bat Guano taken, the 11th refused (the station holds at most 10 at step 0)"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_Water"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "Wood"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "Wood"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "Wood"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "Wood"
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "1",
      "label": "a base batch inside: it starts by itself on the host's station"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "0",
      "label": "the run took the 10 Bat Guano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "bjornitaAdds",
      "prefab": "GP_BatGuano"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_guano",
      "value": "3",
      "label": "she can fill during the run (D-132)"
    },
    {
      "do": "console",
      "command": "skiptime 1900"
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_ready",
      "value": "5",
      "label": "5 Saltpeter piled up"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_state",
      "value": "0",
      "label": "3 Bat Guano is less than a base batch: stopped"
    },
    {
      "do": "peerRpc",
      "target": "vat",
      "method": "GP_VatCollect"
    },
    {
      "do": "check",
      "check": "peerReceived",
      "method": "GP_VatCollected",
      "types": [
        "int"
      ],
      "args": [
        5
      ],
      "label": "Bjornita was sent the 5 Saltpeter"
    },
    {
      "do": "check",
      "check": "noItem",
      "prefab": "GP_Saltpeter",
      "label": "the host got none of them"
    },
    {
      "do": "zdoIs",
      "target": "vat",
      "key": "gp_vat_ready",
      "value": "0",
      "label": "the pile is empty"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
