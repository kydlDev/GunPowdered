{
  "name": "vat-bjornita",
  "description": "Leaching Station in multiplayer (D-035): Bjornita's client feeds one item per request like the game's Smelter - a Stone and an 11th Bat Guano are refused; the host's station runs the batch and her collect request gives HER the 5 Saltpeter",
  "timeout": 120,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "peerJoin" },
    { "do": "spawn", "prefab": "GP_LeachingVat", "dz": 4, "owner": "me", "as": "vat" },
    { "do": "bjornitaAdds", "prefab": "Stone" },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_guano", "value": "none", "label": "a Stone is refused" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "bjornitaAdds", "prefab": "GP_BatGuano" },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_guano", "value": "10", "label": "10 Bat Guano taken, the 11th refused (barrel slot full)" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "bjornitaAdds", "prefab": "GP_Water" },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_loaded", "value": "1", "label": "barrel full after 10 Water" },
    { "do": "bjornitaAdds", "prefab": "Wood" },
    { "do": "bjornitaAdds", "prefab": "Wood" },
    { "do": "bjornitaAdds", "prefab": "Wood" },
    { "do": "bjornitaAdds", "prefab": "Wood" },
    { "do": "wait", "seconds": 5 },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_state", "value": "1", "label": "the hearth burns" },
    { "do": "setZdo", "target": "vat", "key": "gp_vat_start", "type": "long", "value": 1 },
    { "do": "wait", "seconds": 5 },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_state", "value": "2", "label": "done" },
    { "do": "peerRpc", "target": "vat", "method": "GP_VatCollect" },
    { "do": "check", "check": "peerReceived", "method": "GP_VatCollected", "types": [ "int" ], "args": [ 5 ], "label": "Bjornita was sent the 5 Saltpeter" },
    { "do": "check", "check": "noItem", "prefab": "GP_Saltpeter", "label": "the host got none of them" },
    { "do": "zdoIs", "target": "vat", "key": "gp_vat_state", "value": "0", "label": "idle again" },
    { "do": "cleanArena" }
  ],
  "asserts": [ { "check": "noErrors", "source": "GunPowdered" } ]
}
