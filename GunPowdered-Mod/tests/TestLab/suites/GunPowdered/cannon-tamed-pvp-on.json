{
  "name": "cannon-tamed-pvp-on",
  "description": "Hand Cannon (D-055 addendum 2): with PvP on the ball hits a tamed animal like any creature and passes it",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "arenaReadyCannonstockCannonloaded"
    },
    {
      "do": "hook",
      "name": "GunPowdered.setPvp",
      "args": {
        "on": true
      },
      "expect": true,
      "label": "PvP is on"
    },
    {
      "do": "hook",
      "name": "GunPowdered.cannonPlaceOnLine",
      "args": {
        "prefab": "Lox",
        "distance": 14
      },
      "expect": "placed Lox",
      "label": "a Lox 14 m out"
    },
    {
      "do": "hook",
      "name": "GunPowdered.cannonTame",
      "args": {
        "prefab": "Lox"
      },
      "expect": 1,
      "label": "the Lox is tamed"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "cannonFire30"
    },
    {
      "do": "hook",
      "name": "GunPowdered.cannonPassed",
      "expect": 1,
      "label": "the ball passed the tamed Lox"
    },
    {
      "do": "hook",
      "name": "GunPowdered.cannonHurt",
      "args": {
        "prefab": "Lox"
      },
      "expect": 1,
      "label": "the tamed Lox is hurt"
    },
    {
      "do": "cannonClean"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}
