{
  "name": "deposit-refill",
  "description": "Deposit refill (D-154, 2 in-game days): a picked guano deposit gives nothing while empty, still nothing 1 day later, and its full amount again after 2 days",
  "timeout": 90,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "give", "prefab": "PickaxeAntler", "count": 1, "equip": true },
    { "do": "spawnAndPick", "prefab": "GP_GuanoDeposit" },
    { "do": "hook", "name": "GunPowdered.countWithInventory", "args": { "prefab": "GP_BatGuano" }, "expect": 2, "label": "first pick: 2 Bat Guano" },
    { "do": "hook", "name": "GunPowdered.depositVisible", "args": { "target": "deposit" }, "expect": "hidden", "label": "the emptied deposit is hidden while it is not full" },
    { "do": "interact", "target": "deposit" },
    { "do": "wait", "seconds": 2 },
    { "do": "hook", "name": "GunPowdered.countWithInventory", "args": { "prefab": "GP_BatGuano" }, "expect": 2, "label": "an empty deposit gives nothing" },
    { "do": "console", "command": "skiptime 1800" },
    { "do": "wait", "seconds": 2 },
    { "do": "hook", "name": "GunPowdered.depositRespawnCheck", "args": { "target": "deposit" }, "expect": "empty", "label": "1 in-game day (1800 s) later still empty" },
    { "do": "interact", "target": "deposit" },
    { "do": "wait", "seconds": 2 },
    { "do": "hook", "name": "GunPowdered.countWithInventory", "args": { "prefab": "GP_BatGuano" }, "expect": 2, "label": "after 1 day still empty" },
    { "do": "console", "command": "skiptime 2000" },
    { "do": "wait", "seconds": 2 },
    { "do": "hook", "name": "GunPowdered.depositRespawnCheck", "args": { "target": "deposit" }, "expect": "refilled", "label": "past 2 in-game days (3800 s) the deposit refilled" },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "GunPowdered.depositVisible", "args": { "target": "deposit" }, "expect": "visible", "label": "the refilled deposit is visible and full again" },
    { "do": "interact", "target": "deposit" },
    { "do": "wait", "seconds": 3 },
    { "do": "hook", "name": "GunPowdered.countWithInventory", "args": { "prefab": "GP_BatGuano" }, "expect": 4, "label": "after 2 days the deposit gave its 2 again" },
    { "do": "cleanArena" }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" }, { "check": "noErrors", "source": "GunPowdered" } ]
}