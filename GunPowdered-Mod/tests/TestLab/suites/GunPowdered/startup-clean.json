{
  "name": "startup-clean",
  "description": "The mod's own InGameTests pass in a TestLab world and nothing logged an error",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    {
      "do": "wait",
      "seconds": 6
    },
    {
      "do": "hook",
      "name": "GunPowdered.selftest",
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "InGameTests"
    },
    { "do": "cleanArena" }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
    {
      "check": "noErrors",
      "source": "GunPowdered"
    },
    {
      "check": "noErrors",
      "source": "KydlCore"
    }
  ]
}
