{
  "name": "items-drawn-once",
  "description": "T-017 / T-019 (D-150, user 2026-11-21 12:25: spawning 1 dynamite showed 2 sticks, 1 could be picked up): every item of the mod lying on the ground is drawn once - its own model, not also the hand copy under \"attach\".",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    {
      "do": "spawn",
      "prefab": "GP_Dynamite",
      "dx": 0,
      "dz": 3,
      "as": "item0"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.droppedBallModels",
      "args": {
        "prefab": "GP_Dynamite"
      },
      "contains": "drawn 1 time(s)",
      "label": "T-019: a dropped GP_Dynamite is drawn once (D-150: \"spawning 1 dynamite I got 2 sticks\")"
    },
    {
      "do": "console",
      "command": "killall"
    },
