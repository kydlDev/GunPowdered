{
  "name": "deposit-pick-mud",
  "description": "Sulfur deposit (D-022): mined with a pickaxe in hand it gives the amount stored in the deposit (2)",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "GunPowdered.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    { "do": "hook", "name": "GunPowdered.clearLoose", "args": { "prefab": "SulfurStone" }, "label": "no loose SulfurStone left from an earlier test" },
    { "do": "give", "prefab": "PickaxeAntler", "count": 1, "equip": true },
    { "do": "spawnAndPick", "prefab": "GP_SulfurousMud" },
    { "do": "hook", "name": "GunPowdered.countWithInventory", "args": { "prefab": "SulfurStone" }, "expect": 2, "label": "2 Sulfur from the deposit" },
    { "do": "cleanArena" }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" }, { "check": "noErrors", "source": "GunPowdered" } ]
}