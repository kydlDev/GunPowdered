{
  "name": "mobilecannon-pull",
  "description": "D-104: the Mobile Cannon is the game's cart under a cannon model - built, grabbed at the trail and pulled 6 m; it follows and its wheels turn.",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "GunPowdered.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    { "do": "wait", "until": { "check": "hook", "name": "GunPowdered.arenaGround", "contains": "ground flat" }, "timeout": 45 },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonInfo",
      "contains": "cart True",
      "notContains": "storage True",
      "label": "a cart clone with the cannon model and no storage"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonPlace",
      "args": {
        "metres": 4
      },
      "contains": "placed at",
      "label": "build one in front"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonGrab",
      "contains": "grab asked",
      "label": "grab the trail"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonAttached",
      "expect": true,
      "label": "hitched"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonPullStats",
      "contains": "hands on handle True",
      "label": "both hands on the push handle"
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 90,
        "elevation": 10,
        "metres": 2.2
      },
      "contains": "free camera at"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: hands, view 90"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 45,
        "elevation": 15,
        "metres": 2.2
      },
      "contains": "free camera at"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: hands, view 45"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCam",
      "args": {
        "azimuth": 300,
        "elevation": 15,
        "metres": 2.2
      },
      "contains": "free camera at"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot: hands, view 300"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.freeCamOff",
      "contains": "free camera"
    },
    {
      "do": "pressKey",
      "frames": 600,
      "label": "walk backwards (Backward button, about 5 s): the player pulls the cannon",
      "button": "Backward"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonState",
      "regex": "moved ([2-9]|[1-9][0-9]+)\\.\\d m",
      "label": "it rolled along (at least 2 m)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonState",
      "regex": "wheels ([9][0-9]|[1-9][0-9]{2,}) deg",
      "label": "the wheels turned (at least 90 degrees)"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonPullStats",
      "regex": "max speed ([0-3]\\.\\d|4\\.0) m/s",
      "label": "never faster than about 3.5 m/s while pulling"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonPullStats",
      "regex": "stamina used ([1-9]\\d*\\.\\d)",
      "label": "pulling used stamina"
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonPullStats",
      "regex": "facing ([0-9]|[1-3][0-9]) deg",
      "label": "the player faces the cannon (within 40 deg)"
    },
    {
      "do": "invoke",
      "method": "Kydl.GameProbe.ProbeApi.Screenshot",
      "label": "GameProbe shot of the pulled cannon"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "GunPowdered.mobileCannonRemove",
      "contains": "removed"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    { "check": "hook", "name": "kc.errorsThisTest", "expect": "errors 0" },
    {
      "check": "noErrors",
      "source": "GunPowdered"
    }
  ]
}