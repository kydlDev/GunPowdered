<Project Sdk="Microsoft.NET.Sdk">
  <!-- Benchmarks of the mod's game-free rules (PROJECT_RULES 30, skill microbenchmarking in .claude\skills; read its references folder before writing
       benchmarks). The pure files are linked like in the unit-test project, so the benchmarks measure the very code the mod ships. Run from this
       folder, Release only: dotnet run -c Release, then the BenchmarkDotNet flags filter and job after a double dash. Always a filter (the
       switcher asks interactively otherwise); output into a file. Report: BenchmarkDotNet.Artifacts\results\*-report-github.md; keep the numbers in
       ..\_quality\benchmarks.md. Visual Studio is not needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GunPowdered.Benchmarks</AssemblyName>
    <RootNamespace>GunPowdered.Benchmarks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- KydlCore.Core (shared pure contracts): the mod's pure files use it -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\KydlCore\KydlCore-Mod\src\Shared\Core\**\*.cs" Link="Kydl\Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- the mod's pure layers (Domain / Application / Execution): everything linked must compile without Unity. Add single files instead if a layer drags in the engine. -->
    <Compile Include="..\..\src\Features\*\Domain\**\*.cs" Link="Mod\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- pure Core helper the Domain rules use (dice for the deposit rolls) -->
    <Compile Include="..\..\src\Core\Roll.cs" Link="Mod\Core\Roll.cs" />
    <!-- the pure code's debug log (D-128): every rule calls it; unconnected here, so it writes nothing (a11gate: the benchmarks did not build without it) -->
    <Compile Include="..\..\src\Core\RuleLog.cs" Link="Mod\Core\RuleLog.cs" />
    <Compile Include="..\..\src\Core\BatchAmounts.cs" Link="Mod\Core\BatchAmounts.cs" />
    <Compile Include="..\..\src\Core\BatchStationSpec.cs" Link="Mod\Core\BatchStationSpec.cs" />
    <Compile Include="..\..\src\Core\BatchStationRules.cs" Link="Mod\Core\BatchStationRules.cs" />
    <Compile Include="..\..\src\Core\PrefabNames.cs" Link="Mod\Core\PrefabNames.cs" />
    <Compile Include="..\..\src\Core\NoiseRules.cs" Link="Mod\Core\NoiseRules.cs" />
    <Compile Include="..\..\src\Core\SeededRandom.cs" Link="Mod\Core\SeededRandom.cs" />
    <Compile Include="..\..\src\Core\StationPlacementRules.cs" Link="Mod\Core\StationPlacementRules.cs" />
    <Compile Include="..\..\src\Core\BurnRules.cs" Link="Mod\Core\BurnRules.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- version: dotnet add package BenchmarkDotNet resolves the newest one; do not hand-write an older version -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>